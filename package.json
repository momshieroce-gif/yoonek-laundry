{
  "name": "yoonek-laundry",
  "version": "1.0.0",
  "description": "Yoonek Laundry Shop Management System",
  "author": "Yoonek Laundry",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint --ext .js,.vue ./",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "server": "node server/index.js",
    "seed": "node server/seed.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "axios": "^1.4.0",
    "firebase": "^10.7.0",
    "firebase-admin": "^11.11.0",
    "pinia": "^2.1.6",
    "quasar": "^2.12.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@quasar/app-vite": "^1.3.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "electron": "^43.2.0",
    "electron-packager": "^17.1.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-vue": "^9.15.1",
    "express": "^4.18.2",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">= 12.22.1",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
